# Copy to .env.local for local development. .env.local is gitignored — never
# commit real keys. In production these are set as Vercel environment variables.

# ===========================================
# CHAT (all optional)
# ===========================================

# Without ANTHROPIC_API_KEY the chat endpoint reports itself offline and the
# widget hides itself. The rest of the site is unaffected.
ANTHROPIC_API_KEY=

# Deterministic replies, zero tokens spent. Use for local dev and CI.
# MOCK_AI=1

# Global request ceiling per UTC day, across all visitors. Defaults to 300.
# CHAT_DAILY_LIMIT=300

# Upstash Redis backs the per-IP rate limit and the global daily counter.
# Without it both fall back to per-instance memory, which on serverless counts
# each instance separately — fine locally, weaker in production.
# Get one at https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# SITE
# ===========================================

# Live origin. Drives canonical URLs and absolute OG image paths.
# Set this in Vercel; locally it falls back to http://localhost:3000.
NEXT_PUBLIC_URL=

# ===========================================
# ANALYTICS (optional)
# ===========================================

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
